# Copy to ai-service/.env (shared keys can also live in backend/.env)

# LLM routing: auto | gemini | groq
# auto = try Gemini first, fall back to Groq on 429/errors
LLM_PROVIDER=auto

# Gemini (optional if LLM_PROVIDER=groq)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_PRIMARY=gemini-3.1-flash-lite
GEMINI_MODEL_FALLBACK=gemini-3.1-pro-preview

# Groq — paste your real key locally (never commit)
GROQ_API_KEY=
GROQ_MODEL=allam-2-7b
GROQ_REWRITE_MODEL=allam-2-7b

# Same Postgres URL Prisma uses (City / Activity catalogs)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

NODE_BACKEND_URL=http://127.0.0.1:5000
AI_SERVICE_PORT=8000
MAX_REPLAN_ATTEMPTS=3
